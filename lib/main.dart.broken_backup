// ==================== SETTINGS MODEL ====================
enum AppTheme { dark, light, system }
enum PrivacyMode { local, cloud, auto }
enum FontScale { small, medium, large, xlarge }

class OnoSettings {
  String username;
  AppTheme appTheme;
  PrivacyMode privacyMode;
  FontScale fontScale;
  bool sendWithEnter;
  bool showTypingIndicator;
  String cloudApiKey;
  String cloudProvider;

  OnoSettings({
    this.username = 'User',
    this.appTheme = AppTheme.dark,
    this.privacyMode = PrivacyMode.local,
    this.fontScale = FontScale.medium,
    this.sendWithEnter = false,
    this.showTypingIndicator = true,
    this.cloudApiKey = '',
    this.cloudProvider = 'openai',
  });

  double get fontSizeMultiplier {
    switch (fontScale) {
      case FontScale.small: return 0.85;
      case FontScale.medium: return 1.0;
      case FontScale.large: return 1.15;
      case FontScale.xlarge: return 1.3;
    }
  }

  Future<void> save() async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setString('username', username);
    await prefs.setInt('appTheme', appTheme.index);
    await prefs.setInt('privacyMode', privacyMode.index);
    await prefs.setInt('fontScale', fontScale.index);
    await prefs.setBool('sendWithEnter', sendWithEnter);
    await prefs.setBool('showTypingIndicator', showTypingIndicator);
    await prefs.setString('cloudApiKey', cloudApiKey);
    await prefs.setString('cloudProvider', cloudProvider);
  }

  static Future<OnoSettings> load() async {
    final prefs = await SharedPreferences.getInstance();
    return OnoSettings(
      username: prefs.getString('username') ?? 'User',
      appTheme: AppTheme.values[prefs.getInt('appTheme') ?? 0],
      privacyMode: PrivacyMode.values[prefs.getInt('privacyMode') ?? 0],
      fontScale: FontScale.values[prefs.getInt('fontScale') ?? 1],
      sendWithEnter: prefs.getBool('sendWithEnter') ?? false,
      showTypingIndicator: prefs.getBool('showTypingIndicator') ?? true,
      cloudApiKey: prefs.getString('cloudApiKey') ?? '',
      cloudProvider: prefs.getString('cloudProvider') ?? 'openai',
    );
  }

  OnoSettings copy() => OnoSettings(
    username: username, appTheme: appTheme, privacyMode: privacyMode,
    fontScale: fontScale, sendWithEnter: sendWithEnter,
    showTypingIndicator: showTypingIndicator,
    cloudApiKey: cloudApiKey, cloudProvider: cloudProvider,
  );
}

// ==================== MAIN APP ====================
class OnoApp extends StatefulWidget {
  const OnoApp({super.key});

  @override
  State<OnoApp> createState() => _OnoAppState();
}

class _OnoAppState extends State<OnoApp> {
  OnoSettings settings = OnoSettings();
  bool _loaded = false;

  @override
  void initState() {
    super.initState();
    _loadSettings();
  }

  void _loadSettings() async {
    settings = await OnoSettings.load();
    setState(() => _loaded = true);
  }

  void updateSettings(OnoSettings newSettings) {
    setState(() => settings = newSettings);
    settings.save();
  }

  @override
  Widget build(BuildContext context) {
    if (!_loaded) {
      return MaterialApp(
        debugShowCheckedModeBanner: false,
        theme: OnoTheme.darkTheme,
        home: Scaffold(
          backgroundColor: OnoTheme.darkBg,
          body: Center(child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [
            Container(width: 48, height: 48,
              decoration: BoxDecoration(
                gradient: const LinearGradient(colors: [OnoTheme.auroraStart, OnoTheme.auroraEnd]),
                borderRadius: BorderRadius.circular(14),
              ),
            ),
            const SizedBox(height: 16),
            Text('Loading...', style: TextStyle(color: Colors.white54)),
          ])),
        ),
      );
    }

    Brightness brightness;
    switch (settings.appTheme) {
      case AppTheme.dark:
        brightness = Brightness.dark; break;
      case AppTheme.light:
        brightness = Brightness.light; break;
      case AppTheme.system:
        brightness = MediaQuery.platformBrightnessOf(context); break;
    }

    return MaterialApp(
      title: 'Ono',
      debugShowCheckedModeBanner: false,
      theme: OnoTheme.lightTheme,
      darkTheme: OnoTheme.darkTheme,
      themeMode: brightness == Brightness.dark ? ThemeMode.dark : ThemeMode.light,
      home: ChatPage(settings: settings, onSettingsChanged: updateSettings),
    );
  }
}

// ==================== CHAT PAGE ====================
class ChatPage extends StatefulWidget {
  final OnoSettings settings;
  final ValueChanged<OnoSettings> onSettingsChanged;

  const ChatPage({super.key, required this.settings, required this.onSettingsChanged});

  @override
  State<ChatPage> createState() => _ChatPageState();
}

class _ChatPageState extends State<ChatPage> {
  final List<ChatMessage> _messages = [];
  final TextEditingController _controller = TextEditingController();
  final ScrollController _scrollController = ScrollController();
  bool _isLoading = false;
  String _connectionStatus = 'connecting';

  OnoSettings get settings => widget.settings;

  @override
  void initState() {
    super.initState();
    _checkConnection();
  }

  Future<void> _checkConnection() async {
    try {
      final response = await http
          .get(Uri.parse('http://localhost:8000/health'))
          .timeout(const Duration(seconds: 2));
      if (response.statusCode == 200) {
        setState(() => _connectionStatus = 'connected');
      } else {
        setState(() => _connectionStatus = 'error');
      }
    } catch (e) {
      setState(() => _connectionStatus = 'disconnected');
    }
  }

  Future<void> _sendMessage() async {
    if (_controller.text.trim().isEmpty || _isLoading) return;
    final text = _controller.text.trim();
    _controller.clear();

    setState(() {
      _messages.add(ChatMessage(text: text, isUser: true));
      _isLoading = true;
    });
    _scrollToBottom();

    try {
      final response = await http.post(
        Uri.parse('http://localhost:8000/api/chat'),
        headers: {'Content-Type': 'application/json'},
        body: jsonEncode({
          'message': text,
          'model': 'qwen2.5:3b',
          'history': _messages
              .where((m) => m != _messages.last)
              .map((m) => {'role': m.isUser ? 'user' : 'assistant', 'content': m.text})
              .toList(),
        }),
      ).timeout(const Duration(seconds: 60));

      if (response.statusCode == 200) {
        final data = jsonDecode(response.body);
        setState(() {
          _messages.add(ChatMessage(text: data['response'] ?? 'No response', isUser: false));
        });
      } else {
        setState(() {
          _messages.add(ChatMessage(text: 'Error: ${response.statusCode}', isUser: false));
        });
      }
    } catch (e) {
      setState(() {
        _messages.add(ChatMessage(text: 'Cannot connect to backend.', isUser: false));
      });
    } finally {
      setState(() => _isLoading = false);
      _scrollToBottom();
    }
  }

  void _scrollToBottom() {
    Future.delayed(const Duration(milliseconds: 100), () {
      if (_scrollController.hasClients) {
        _scrollController.animateTo(
          _scrollController.position.maxScrollExtent,
          duration: const Duration(milliseconds: 300), curve: Curves.easeOut,
        );
      }
    });
  }

  void _goToSettings() async {
    final result = await Navigator.push<OnoSettings>(
      context,
      MaterialPageRoute(builder: (_) => SettingsPage(settings: settings)),
    );
    if (result != null) {
      widget.onSettingsChanged(result);
    }
  }

  @override
  Widget build(BuildContext context) {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    final textColor = isDark ? Colors.white : Colors.black87;
    final surfaceColor = isDark ? OnoTheme.surfaceDark : Colors.white;

    return Scaffold(
      appBar: AppBar(
        title: Row(children: [
          Container(width: 32, height: 32,
            decoration: BoxDecoration(
              gradient: const LinearGradient(colors: [OnoTheme.auroraStart, OnoTheme.auroraEnd]),
              borderRadius: BorderRadius.circular(8),
            ),
            child: ClipRRect(
              borderRadius: BorderRadius.circular(8),
              child: Image.asset('assets/ono_logo.png', fit: BoxFit.cover,
                  errorBuilder: (_, __, ___) => Container()),
            ),
          ),
          const SizedBox(width: 12),
          Text('Ono', style: TextStyle(fontSize: 20, fontWeight: FontWeight.w600, color: textColor)),
          const Spacer(),
          _buildConnectionIndicator(),
          const SizedBox(width: 16),
          IconButton(
            icon: Icon(Icons.settings_outlined, color: textColor.withOpacity(0.7)),
            onPressed: _goToSettings, tooltip: 'Settings',
          ),
        ]),
      ),
      body: Column(children: [
        Expanded(
          child: _messages.isEmpty
              ? _buildEmptyState(isDark, textColor)
              : ListView.builder(
                  controller: _scrollController,
                  padding: const EdgeInsets.all(16),
                  itemCount: _messages.length + (_isLoading && settings.showTypingIndicator ? 1 : 0),
                  itemBuilder: (context, index) {
                    if (index == _messages.length && _isLoading) return _buildTypingIndicator(isDark);
                    return _buildMessageBubble(_messages[index], isDark, surfaceColor, textColor);
                  },
                ),
        ),
        _buildInputArea(isDark, surfaceColor, textColor),
      ]),
    );
  }

  Widget _buildConnectionIndicator() {
    Color color;
    String tooltip;
    switch (_connectionStatus) {
      case 'connected':
        color = OnoTheme.auroraEnd; tooltip = 'Connected'; break;
      case 'connecting':
        color = Colors.orange; tooltip = 'Connecting...'; break;
      default:
        color = Colors.redAccent; tooltip = 'Disconnected';
    }
    return Tooltip(message: tooltip, child: Container(
      width: 10, height: 10,
      decoration: BoxDecoration(color: color, shape: BoxShape.circle,
          boxShadow: [BoxShadow(color: color.withOpacity(0.5), blurRadius: 6)]),
    ));
  }

  Widget _buildEmptyState(bool isDark, Color textColor) {
    return Center(child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [
      Container(width: 80, height: 80,
        decoration: BoxDecoration(
          gradient: const LinearGradient(colors: [OnoTheme.auroraStart, OnoTheme.auroraEnd]),
          borderRadius: BorderRadius.circular(20),
          boxShadow: [BoxShadow(color: OnoTheme.auroraEnd.withOpacity(0.25), blurRadius: 24, spreadRadius: 4)],
        ),
      ),
      const SizedBox(height: 24),
      Text('Ono', style: TextStyle(fontSize: 28, fontWeight: FontWeight.bold, color: textColor)),
      const SizedBox(height: 8),
      Text('把糊涂的事理清楚', style: TextStyle(fontSize: 14, color: textColor.withOpacity(0.5))),
      const SizedBox(height: 32),
      Text('Try: "帮我总结一下今天的任务"', style: TextStyle(fontSize: 13, color: textColor.withOpacity(0.35), fontStyle: FontStyle.italic)),
    ]));
  }

  Widget _buildMessageBubble(ChatMessage message, bool isDark, Color surfaceColor, Color textColor) {
    final baseFontSize = 15.0 * settings.fontSizeMultiplier;
    return Padding(padding: const EdgeInsets.only(bottom: 12), child: Row(
      mainAxisAlignment: message.isUser ? MainAxisAlignment.end : MainAxisAlignment.start,
      crossAxisAlignment: CrossAxisAlignment.end,
      children: [
        if (!message.isUser) ...[
          Container(width: 28, height: 28,
            decoration: BoxDecoration(
              gradient: const LinearGradient(colors: [OnoTheme.auroraStart, OnoTheme.auroraEnd]),
              borderRadius: BorderRadius.circular(8),
            ),
          ),
          const SizedBox(width: 8),
        ],
        Flexible(child: Container(
          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
          decoration: BoxDecoration(
            gradient: message.isUser
                ? const LinearGradient(colors: [OnoTheme.auroraStart, Color(0xFF1a6b8a)])
                : null,
            color: message.isUser ? null : surfaceColor,
            borderRadius: BorderRadius.only(
              topLeft: const Radius.circular(16), topRight: const Radius.circular(16),
              bottomLeft: Radius.circular(message.isUser ? 16 : 4),
              bottomRight: Radius.circular(message.isUser ? 4 : 16),
            ),
            border: message.userAgent ? null : Border.all(
                color: isDark ? OnoTheme.auroraEnd.withOpacity(0.15) : Colors.grey.shade300, width: 1),
          ),
          child: SelectableText(message.text,
            style: TextStyle(fontSize: baseFontSize, color: textColor, height: 1.4)),
        )),
        if (message.isUser) ...[
          const SizedBox(width: 8),
          Container(width: 28, height: 28,
            decoration: BoxDecoration(
              color: isDark ? const Color(0xFF2A2A2A) : Colors.grey.shade200,
              borderRadius: BorderRadius.circular(8),
            ),
            child: Icon(Icons.person, size: 16, color: isDark ? Colors.white70 : Colors.black54),
          ),
        ],
      ],
    ));
  }

  Widget _buildTypingIndicator(bool isDark) {
    final surfaceColor = isDark ? OnoTheme.surfaceDark : Colors.white;
    return Padding(padding: const EdgeInsets.only(bottom: 12), child: Row(children: [
      Container(width: 28, height: 28,
        decoration: BoxDecoration(
          gradient: const LinearGradient(colors: [OnoTheme.auroraStart, OnoTheme.auroraEnd]),
          borderRadius: BorderRadius.circular(8),
        ),
      ),
      const SizedBox(width: 8),
      Container(
        padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
        decoration: BoxDecoration(
          color: surfaceColor,
          borderRadius: const BorderRadius.only(topLeft: Radius.circular(16), topRight: Radius.circular(16),
              bottomLeft: Radius.circular(4), bottomRight: Radius.circular(16)),
          border: Border.all(color: isDark ? OnoTheme.auroraEnd.withOpacity(0.15) : Colors.grey.shade300),
        ),
        child: Row(mainAxisSize: MainAxisSize.min, children: [
          for (int i = 0; i < 3; i++) ...[
            _buildTypingDot(i),
            if (i < 2) const SizedBox(width: 4),
          ],
        ]),
      ),
    ]));
  }

  Widget _buildTypingDot(int index) {
    return TweenAnimationBuilder<double>(
      tween: Tween(begin: 0.0, end: 1.0),
      duration: Duration(milliseconds: 600 + (index * 200)),
      builder: (context, value, child) => Opacity(
        opacity: 0.4 + (value * 0.6),
        child: Container(width: 8, height: 8,
          decoration: const BoxDecoration(
            gradient: LinearGradient(colors: [OnoTheme.auroraStart, OnoTheme.auroraEnd]),
            shape: BoxShape.circle,
          ),
        ),
      ),
    );
  }

  Widget _buildInputArea(bool isDark, Color surfaceColor, Color textColor) {
    return Container(
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: isDark ? OnoTheme.darkBg : Colors.white,
        border: Border(top: BorderSide(
            color: isDark ? OnoTheme.auroraEnd.withOpacity(0.08) : Colors.grey.shade200, width: 1)),
      ),
      child: SafeArea(child: Row(crossAxisAlignment: CrossAxisAlignment.end, children: [
        Expanded(child: Container(
          decoration: BoxDecoration(
            color: surfaceColor,
            borderRadius: BorderRadius.circular(24),
            border: Border.all(color: isDark ? OnoTheme.auroraEnd.withOpacity(0.25) : Colors.grey.shade300, width: 1),
          ),
          child: TextField(
            controller: _controller,
            style: TextStyle(color: textColor, fontSize: 15 * settings.fontSizeMultiplier),
            maxLines: 4, minLines: 1,
            textInputAction: settings.sendWithEnter ? TextInputAction.send : TextInputAction.newline,
            onSubmitted: (_) { if (settings.sendWithEnter) _sendMessage(); },
            decoration: InputDecoration(
              hintText: 'Message Ono...',
              hintStyle: TextStyle(color: textColor.withOpacity(0.35)),
              border: InputBorder.none,
              contentPadding: const EdgeInsets.symmetric(horizontal: 20, vertical: 12),
            ),
          ),
        )),
        const SizedBox(width: 12),
        Container(decoration: BoxDecoration(
          gradient: const LinearGradient(colors: [OnoTheme.auroraStart, OnoTheme.auroraEnd]),
          shape: BoxShape.circle,
          boxShadow: [BoxShadow(color: OnoTheme.auroraEnd.withOpacity(0.3), blurRadius: 10)],
        ), child: IconButton(
          icon: const Icon(Icons.send, color: Colors.white),
          onPressed: _isLoading ? null : _sendMessage,
        )),
      ])),
    );
  }
}


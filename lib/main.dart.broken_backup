  void _confirmClearData(BuildContext context, bool isDark) {
    showDialog(context: context, builder: (ctx) => AlertDialog(
      backgroundColor: isDark ? OnoTheme.surfaceDark : Colors.white,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
      title: Text('⚠️ Clear All Data?', style: TextStyle(color: Colors.red.shade400)),
      content: Text('This will delete all chat history and reset all preferences.\n\nThis cannot be undone.',
          style: TextStyle(color: isDark ? Colors.white70 : Colors.black54)),
      actions: [
        TextButton(onPressed: () => Navigator.pop(ctx),
            child: Text('Cancel', style: TextStyle(color: subColorFor(isDark)))),
        TextButton(onPressed: () async {
          final prefs = await SharedPreferences.getInstance();
          await prefs.clear();
          if (mounted) Navigator.popUntil(ctx, (r) => r.isFirst);
        }, child: Text('Delete Everything', style: TextStyle(color: Colors.red.shade400, fontWeight: FontWeight.w600))),
      ],
    ));
  }

  String _themeLabel(AppTheme t) => {'dark': '🌙 Dark', 'light': '☀️ Light', 'system': '💻 System'}[t.name]!;
  String _fontLabel(FontScale f) => {'small': 'Small', 'medium': 'Medium', 'large': 'Large', 'xlarge': 'X-Large'}[f.name]!;
  String _privacyLabel(PrivacyMode p) => {'local': '🔒 Local', 'cloud': '☁️ Cloud', 'auto': '🔄 Auto'}[p.name]!;
  Color subColorFor(bool isDark) => isDark ? Colors.white60 : Colors.black45;
}

